# Copie para .env (o .env não vai para o git). Lido automaticamente pelo servidor.

# Banco Postgres (Supabase: endereço do pooler, modo transação). Vazio = Postgres embutido local.
# DATABASE_URL=postgres://usuario:senha@host:6543/postgres
# Pasta do Postgres embutido (padrão: data/pg, ou %LOCALAPPDATA%\QIMAHub\pg se o projeto estiver no OneDrive)
# QIMA_PG_DIR=

# Segredo que protege a chave da IA (obrigatório em produção; sem ele usa o arquivo data/.chave-hub)
# QIMA_SEGREDO=

# Porta da API em produção
# PORT=8080

# Leitura de notas por IA: nome do conector em core/server/ai-providers/<nome>.js
# "demo" só lê os cupons de teste (scripts/seed-despesas.mjs). Deixe vazio para modo manual.
# QIMA_AI_PROVIDER=demo

# Fotos e anexos no Supabase Storage (bucket privado "qima-arquivos", criado por `npm run migrate`).
# Chave SECRETA: Project Settings > API Keys > Secret key. Só no servidor; nunca versione.
# Sem ela, em desenvolvimento os arquivos ficam em data/uploads; na Vercel o envio de fotos é recusado.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_KEY=

# Leitura de notas pelo DeepSeek. Vale só se nada foi salvo em Administração > Inteligência artificial
# (o que está salvo lá, com a chave criptografada, tem prioridade). Nunca versione a chave.
# DEEPSEEK_API_KEY=
# QIMA_AI_MODEL=deepseek-flash

# Administrador criado no primeiro start
# QIMA_ADMIN_EMAIL=admin@qima.local
# QIMA_ADMIN_PASSWORD=troque-esta-senha

# Endereço público do site, usado nos links de redefinição de senha (na Vercel, se vazio, usa o domínio de produção)
# QIMA_URL=https://qima-hub.vercel.app
# Outros domínios autorizados a enviar pedidos de alteração (separados por vírgula; normalmente vazio)
# QIMA_ORIGENS=
# Com Cloudflare na frente: mesmo valor da regra que adiciona o cabeçalho x-origin-verify (sem isso os limites por IP veem só o IP do Cloudflare)
# QIMA_CF_SEGREDO=
# Só se houver um proxy seu na frente do servidor: confiar no IP de x-forwarded-for
# QIMA_CONFIAR_PROXY=1
