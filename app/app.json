{
  "expo": {
    "name": "QIMA HUB",
    "slug": "qima-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "qimahub",
    "android": {
      "package": "br.com.qima.hub",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      ["expo-camera", { "cameraPermission": "Usar a câmera para fotografar os veículos e os comprovantes.", "recordAudioAndroid": false }],
      ["expo-location", { "locationWhenInUsePermission": "Usar a localização para marcar onde a foto do veículo foi tirada." }],
      ["expo-local-authentication", { "faceIDPermission": "Usar o Face ID para desbloquear o QIMA HUB." }],
      ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#e4002b" }]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
